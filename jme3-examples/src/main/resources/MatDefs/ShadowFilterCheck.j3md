MaterialDef Shadow filter check {
    MaterialParameters {
        Texture2D Atlas
        Vector2 AtlasSize
        Vector4 Rect
        Float Radius
        Vector2 PlaneSlope
    }
    Technique {
        VertexShader GLSL150: Common/MatDefs/Misc/Unshaded.vert
        FragmentShader GLSL150: MatDefs/ShadowFilterCheck.frag
        WorldParameters {
            WorldViewProjectionMatrix
        }
        Defines {
            PLANE: PlaneSlope
        }
        RenderState {
            DepthTest Off
            DepthWrite Off
            FaceCull Off
        }
    }
}
