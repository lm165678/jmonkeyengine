uniform mat4 m_InverseProjection;
float sceneDepth(vec2 uv) {
    #ifdef RESOLVE_DEPTH_MS
        float depth = 1.0;
        for (int i = 0; i < m_NumSamplesDepth; i++) {
            depth = min(depth, fetchTextureSample(m_DepthTexture, uv, i).r);
        }
        return depth;
    #else
        return getDepth(m_DepthTexture, uv).r;
    #endif
}
vec3 viewPosition(vec2 uv) {
    float depth = sceneDepth(uv);
    vec4 p = m_InverseProjection * vec4(uv * 2.0 - 1.0, depth * 2.0 - 1.0, 1.0);
    return p.xyz / p.w;
}
