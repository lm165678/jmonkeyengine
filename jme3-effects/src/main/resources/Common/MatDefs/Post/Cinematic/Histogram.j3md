MaterialDef Histogram {
    MaterialParameters {
        Int BoundDrawBuffer
        Int NumSamples
        Vector2 LogRange
        Boolean UE4Mode
        Texture2D Texture
    }
    Technique {
        VertexShader GLSL300 GLSL150: Common/MatDefs/Post/Post.vert
        FragmentShader GLSL300 GLSL150: Common/MatDefs/Post/Cinematic/Histogram.frag
        Defines {
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            RESOLVE_MS: NumSamples
        }
    }
}
