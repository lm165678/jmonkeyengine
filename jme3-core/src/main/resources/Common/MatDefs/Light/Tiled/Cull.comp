layout(local_size_x=64) in;
layout(std430) buffer TileIndices { int tileRecords[]; };
uniform sampler2D Lights;
uniform mat4 View, Projection;
uniform vec2 Resolution;
uniform float Near, Far;
uniform int Columns, TileSize, LightCount, TileCapacity;
uniform bool ConservativeBounds;
shared uint count;
void writeIndex(int address,int value){tileRecords[address]=value;}
bool intersectsPlane(vec4 plane,vec3 center,float radius){
 return dot(plane,vec4(center,1.0))>=-radius*length(plane.xyz);
}
void main(){
 uint lane=gl_LocalInvocationIndex;
 ivec2 tile=ivec2(gl_WorkGroupID.xy);
 int base=(tile.y*Columns+tile.x)*(TileCapacity+1);
 vec2 tileLo=vec2(tile*TileSize),tileHi=min(tileLo+vec2(TileSize),Resolution);
 vec2 ndcLo=tileLo/Resolution*2.0-1.0,ndcHi=tileHi/Resolution*2.0-1.0;
 vec4 rowX=vec4(Projection[0][0],Projection[1][0],Projection[2][0],Projection[3][0]);
 vec4 rowY=vec4(Projection[0][1],Projection[1][1],Projection[2][1],Projection[3][1]);
 vec4 rowW=vec4(Projection[0][3],Projection[1][3],Projection[2][3],Projection[3][3]);
 if(lane==0u) count=0u;
 barrier();
 for(int i=int(lane);i<LightCount;i+=64){
 vec4 color=texelFetch(Lights,ivec2(0,i),0),pos=texelFetch(Lights,ivec2(1,i),0);
 bool visible=color.w<0.5 || pos.w==0.0;
 if(!visible){
 float radius=1.0/pos.w;
 vec3 center=(View*vec4(pos.xyz,1.0)).xyz;
 float depth=-center.z;
 if(depth+radius>=Near && depth-radius<=Far){
 if(!ConservativeBounds){
 visible=intersectsPlane(rowX-ndcLo.x*rowW,center,radius)
      &&intersectsPlane(ndcHi.x*rowW-rowX,center,radius)
      &&intersectsPlane(rowY-ndcLo.y*rowW,center,radius)
      &&intersectsPlane(ndcHi.y*rowW-rowY,center,radius);
 }else{
 if(depth-radius<=Near) visible=true;
 else{
 vec2 lo=vec2(1e30),hi=vec2(-1e30);
 for(int c=0;c<8;c++){
 vec3 corner=center+vec3((c&1)==0?-radius:radius,(c&2)==0?-radius:radius,(c&4)==0?-radius:radius);
 vec4 clip=Projection*vec4(corner,1.0);
 vec2 screen=(clip.xy/clip.w*0.5+0.5)*Resolution;
 lo=min(lo,screen);hi=max(hi,screen);
 }
 visible=all(greaterThanEqual(hi,tileLo))&&all(lessThan(lo,tileHi));
 }
 }
 }
 }
 if(visible){uint slot=atomicAdd(count,1u);if(slot<uint(TileCapacity))writeIndex(base+1+int(slot),i);}
 }
 barrier();
 if(lane==0u) writeIndex(base,int(count));
}
