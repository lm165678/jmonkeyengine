MaterialDef Probe Lightmap Bake {
    MaterialParameters {
        Int LightmapBand
        Texture2D NormalMap -LINEAR
        Float NormalType
        Float NormalScale
        Boolean GiEnabled
        Boolean GiBakeBounce
        Texture2D GiIrradiance -LINEAR
        Texture2D GiMoments -LINEAR
        Texture2D GiSkyVisibility -LINEAR
        Texture2D GiVolumeData -LINEAR
        Int GiVolumeCount
        Int GiVolumeDataHeight
        Float GiBias
        Float GiEnvironmentMix
        Float GiFadeDistance
        Vector3 GiOrigin
        Vector3 GiSpacing
        Vector3 GiCounts
        Vector4 GiAtlas
        Vector2 GiEncoding
        Vector4 GiTextureSize
    }
    Technique {
        VertexShader GLSL150: Common/MatDefs/Light/ProbeLightmapBake.vert
        FragmentShader GLSL150: Common/MatDefs/Light/ProbeLightmapBake.frag
        WorldParameters {
            WorldMatrix
            WorldNormalMatrix
        }
        Defines {
            NORMALMAP : NormalMap
        }
        RenderState {
            DepthTest Off
            DepthWrite Off
            FaceCull Off
        }
    }
}
