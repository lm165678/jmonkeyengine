MaterialDef Preintegrated Skin {
    // This material uses the forward queue in deferred viewports.

    MaterialParameters {
        Boolean BakedDirectionalShadows
        // SkinLutGenerator supplies matching texture/range/dimensions.
        Texture2D SkinLut -LINEAR
        Vector2 SkinLutSize : 256.0 128.0
        Float SkinMaxCurvature : 1.0
        // Meter world units by default. Centimeters use 10, millimeters use 1.
        Float SkinWorldToMillimeters : 1000.0
        Float SkinStrength : 1.0
        // Scales the curvature lookup; normal smoothing has separate controls.
        Float SkinScatteringScale : 1.0
        // Optional R normalized curvature; 1 = SkinMaxCurvature (inverse mm).
        Texture2D SkinCurvatureMap -LINEAR
        Texture2D SkinMask -LINEAR
        // Optional authored tangent-space diffuse normal, same convention as NormalMap.
        Texture2D SkinDiffuseNormalMap -LINEAR
        // Full per-channel prefiltering overrides the corresponding two-normal blend.
        Texture2D SkinRedNormalMap -LINEAR
        Texture2D SkinGreenNormalMap -LINEAR
        Texture2D SkinBlueNormalMap -LINEAR
        // Otherwise sample NormalMap with this minimum LOD, leaving coarser mips intact.
        Float SkinNormalMinLod : 3.0
        // Fractions of detailed normal in R/G/B diffuse normals; specular stays detailed.
        Vector3 SkinNormalWeights : 0.15 0.5 0.85
        // Optional thin-surface transmission; disabled variants omit all related work.
        Boolean SkinTransmission : false
        // R stores normal thickness / SkinThickness, linear; white means maximum thickness.
        // A stores resolved exit coverage (1 for ordinary opaque-alpha thickness maps).
        Texture2D SkinThicknessMap -LINEAR
        // Millimeters; also the constant thickness when no map is bound.
        Float SkinThickness : 30.0
        // Per-channel e-folding distance in millimeters; larger red travels farther.
        Vector3 SkinAttenuationDistance : 3.0 1.0 0.5
        Color SkinTransmissionColor : 1.0 1.0 1.0 1.0
        Float SkinTransmissionStrength : 1.0
        // Internal per-view motion inputs; populated by TemporalAAFilter.
        Boolean TemporalGpuInstances
        Boolean TemporalVelocity
        Matrix4 TemporalCurrentVP
        Matrix4 TemporalPreviousVP
        Matrix4 TemporalPreviousWorld
        Boolean TemporalValid

        // Bind these parameters to enable baked diffuse GI.
        // Use GiProbeData.bind() and close the binding to restore the previous values.
        Texture2D GiIrradiance -LINEAR
        Texture2D GiStaticLightmap -LINEAR
        Float GiLightmapAtlasInset : 0.0
        Texture2D GiMoments -LINEAR
        Texture2D GiSkyVisibility -LINEAR
        // Single-volume boundary transition in world units; 0 disables fading.
        Float GiFadeDistance : 1.0
        Vector3 GiOrigin
        Vector3 GiSpacing
        Vector3 GiCounts
        Vector4 GiAtlas
        Float GiBias : 0.05
        Boolean GiEnabled : false
        // Internal render-thread bake override; leave false in applications.
        Boolean GiBakeBounce : false
        // 0 replaces environment diffuse inside GI coverage; 1 explicitly adds it.
        Float GiEnvironmentMix : 0.0
        Boolean EnvironmentLighting : true
        Vector2 GiEncoding : 1.0 1.0
        Texture2D GiVolumeData -LINEAR
        Int GiVolumeCount : 0
        Int GiVolumeDataHeight : 0
        Vector4 GiTextureSize

        Int BoundDrawBuffer
        Texture2D DeferredLightData
        Int DeferredLightCount
        Int DeferredShadingId
        Boolean DeferredGiPayload
        Boolean DeferredGiInLighting

        // Alpha threshold for fragment discarding
        Float AlphaDiscardThreshold (AlphaTestFallOff)

        //metallicity of the material
        Float Metallic : 0.0
        //Roughness of the material
        Float Roughness : 0.45
        // Base material color
        Color BaseColor : 1.0 1.0 1.0 1.0
        // The emissive color of the object
        Color Emissive
        // the emissive power
        Float EmissivePower : 3.0
        // the emissive intensity
        Float EmissiveIntensity : 2.0

        //Optional vec3 for adjusting the final BaseColor in HSV color space
        Vector3 HSVOffset

        // BaseColor map
        Texture2D BaseColorMap

        // Metallic map
        Texture2D MetallicMap -LINEAR

        // Roughness Map
        Texture2D RoughnessMap -LINEAR

        //Metallic and Roughness are packed respectively in the b and g channel of a single map
        // r: AO (if AoPackedInMRMap is true)
        // g: Roughness
        // b: Metallic
        Texture2D MetallicRoughnessMap -LINEAR

        // Texture of the emissive parts of the material
        Texture2D EmissiveMap

        // Normal map
        Texture2D NormalMap -LINEAR
        // The scalar parameter applied to each normal vector of the normal map
        Float NormalScale

        //The type of normal map: -1.0 (DirectX), 1.0 (OpenGl)
        Float NormalType : 1.0

        // For Spec gloss pipeline
        Boolean UseSpecGloss
        Texture2D SpecularMap
        Texture2D GlossinessMap
        Texture2D SpecularGlossinessMap
        Color Specular : 1.0 1.0 1.0 1.0
        Float Glossiness : 1.0

        // Parallax/height map
        Texture2D ParallaxMap -LINEAR

        // Specular-AA
        Boolean UseSpecularAA : true
        // screen space variance,Use the slider to set the strength of the geometric specular anti-aliasing effect between 0 and 1. Higher values produce a blurrier result with less aliasing.
        Float SpecularAASigma
        // clamping threshold,Use the slider to set a maximum value for the offset that HDRP subtracts from the smoothness value to reduce artifacts.
        Float SpecularAAKappa

        //Set to true if parallax map is stored in the alpha channel of the normal map
        Boolean PackedNormalParallax

        //Sets the relief height for parallax mapping
        Float ParallaxHeight : 0.05

        //Set to true to activate Steep Parallax mapping
        Boolean SteepParallax

        //Horizon fade
        Boolean HorizonFade

        // Linear irradiance/AO data. glTF occlusion textures (including shared
        // metallic/roughness images) must not undergo sRGB decoding.
        Texture2D LightMap -LINEAR

        // A scalar multiplier controlling the amount of occlusion applied.
        // A value of `0.0` means no occlusion. A value of `1.0` means full occlusion.
        Float AoStrength

        // Set to use TexCoord2 for the lightmap sampling
        Boolean SeparateTexCoord
        // the light map is a grayscale ao map, only the r channel will be read.
        Boolean LightMapAsAOMap
        Boolean AoPackedInMRMap
        //shadows
        Int FilterMode
        Boolean HardwareShadows

        Texture2D ShadowMap0
        Texture2D ShadowMap1
        Texture2D ShadowMap2
        Texture2D ShadowMap3
        //pointLights
        Texture2D ShadowMap4
        Texture2D ShadowMap5

        Float ShadowIntensity
        Vector4 Splits
        Vector2 FadeInfo

        Matrix4 LightViewProjectionMatrix0
        Matrix4 LightViewProjectionMatrix1
        Matrix4 LightViewProjectionMatrix2
        Matrix4 LightViewProjectionMatrix3
        //pointLight
        Matrix4 LightViewProjectionMatrix4
        Matrix4 LightViewProjectionMatrix5
        Vector3 LightPos
        Vector3 LightDir

        Float PCFEdge
        Float ShadowMapSize

        // For hardware skinning
        Int NumberOfBones
        Matrix4Array BoneMatrices

        // For Morph animation
        FloatArray MorphWeights
        Int NumberOfMorphTargets
        Int NumberOfTargetsBuffers

        // For instancing
        Boolean UseInstancing

        // For Vertex Color
        Boolean UseVertexColor

        Boolean BackfaceShadows : false

        Boolean UseFog
        Color FogColor
        Vector2 LinearFog
        Float ExpFog
        Float ExpSqFog

        // Optional sunlight/probe exposure adjustment, disabled when all three inputs are unset.
        // A false UseVertexColorsAsSunIntensity does not enable the adjustment.
        Texture2D SunLightExposureMap
        Boolean UseVertexColorsAsSunIntensity
        Float StaticSunIntensity
        // Only affects the minimum probe brightness when a sunlight exposure input is enabled.
        Boolean BrightenIndoorShadows

         // debug the final value of the selected layer as a color output
        Int DebugValuesMode
            // Layers:
            //   0 - albedo (unshaded)
            //   1 - normals
            //   2 - roughness
            //   3 - metallic
            //   4 - ao
            //   5 - emissive
            //   6 - exposure
            //   7 - alpha
            //   8 - geometryNormals
    }

    Technique {
        LightModel SinglePassAndImageBased

        VertexShader GLSL330 GLSL300:   Common/MatDefs/Light/PBRLighting.vert
        FragmentShader GLSL330 GLSL300: Common/MatDefs/Light/PreintegratedSkin.frag

        WorldParameters {
            WorldViewProjectionMatrix
            CameraPosition
            WorldMatrix
            WorldNormalMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        Defines {
            BAKED_DIRECTIONAL_SHADOWS : BakedDirectionalShadows
            SKIN_LUT : SkinLut
            SKIN_CURVATURE : SkinCurvatureMap
            SKIN_MASK : SkinMask
            SKIN_DIFFUSE_NORMAL : SkinDiffuseNormalMap
            SKIN_RED_NORMAL : SkinRedNormalMap
            SKIN_GREEN_NORMAL : SkinGreenNormalMap
            SKIN_BLUE_NORMAL : SkinBlueNormalMap
            SKIN_TRANSMISSION : SkinTransmission
            SKIN_THICKNESS_MAP : SkinThicknessMap
            TEMPORAL_GPU_INSTANCES : TemporalGpuInstances
            TEMPORAL_VELOCITY : TemporalVelocity
            GI_PROBES : GiIrradiance
            STATIC_PROBE_LIGHTMAP : GiStaticLightmap
            ENVIRONMENT_LIGHTING : EnvironmentLighting
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            BASECOLORMAP : BaseColorMap
            NORMALMAP : NormalMap
            NORMALSCALE : NormalScale
            METALLICMAP : MetallicMap
            ROUGHNESSMAP : RoughnessMap
            EMISSIVEMAP : EmissiveMap
            EMISSIVE : Emissive
            SPECGLOSSPIPELINE : UseSpecGloss
            PARALLAXMAP : ParallaxMap
            NORMALMAP_PARALLAX : PackedNormalParallax
            STEEP_PARALLAX : SteepParallax
            LIGHTMAP : LightMap
            SEPARATE_TEXCOORD : SeparateTexCoord
            DISCARD_ALPHA : AlphaDiscardThreshold
            NUM_BONES : NumberOfBones
            INSTANCING : UseInstancing
            USE_PACKED_MR: MetallicRoughnessMap
            USE_PACKED_SG: SpecularGlossinessMap
            SPECULARMAP : SpecularMap
            SPECULAR_AA : UseSpecularAA
            SPECULAR_AA_SCREEN_SPACE_VARIANCE : SpecularAASigma
            SPECULAR_AA_THRESHOLD : SpecularAAKappa
            GLOSSINESSMAP : GlossinessMap
            NORMAL_TYPE: NormalType
            VERTEX_COLOR : UseVertexColor
            AO_MAP: LightMapAsAOMap
            AO_PACKED_IN_MR_MAP : AoPackedInMRMap
            AO_STRENGTH : AoStrength
            NUM_MORPH_TARGETS: NumberOfMorphTargets
            NUM_TARGETS_BUFFERS: NumberOfTargetsBuffers
            HORIZON_FADE: HorizonFade
            EXPOSUREMAP : SunLightExposureMap
            USE_VERTEX_COLORS_AS_SUN_INTENSITY : UseVertexColorsAsSunIntensity
            STATIC_SUN_INTENSITY : StaticSunIntensity
            BRIGHTEN_INDOOR_SHADOWS : BrightenIndoorShadows
            DEBUG_VALUES_MODE : DebugValuesMode
            USE_FOG : UseFog
            FOG_LINEAR : LinearFog
            FOG_EXP : ExpFog
            FOG_EXPSQ : ExpSqFog
            HSV_OFFSET : HSVOffset
        }
    }


    Technique PreShadow {

        VertexShader GLSL330 GLSL300 GLSL150 GLSL100:   Common/MatDefs/Shadow/PreShadow.vert
        FragmentShader GLSL330 GLSL300 GLSL150 GLSL100: Common/MatDefs/Shadow/PreShadowPBR.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldViewMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        Defines {
            TEMPORAL_GPU_INSTANCES : TemporalGpuInstances
            TEMPORAL_VELOCITY : TemporalVelocity
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            DISCARD_ALPHA : AlphaDiscardThreshold
            NUM_BONES : NumberOfBones
            INSTANCING : UseInstancing
            NUM_MORPH_TARGETS: NumberOfMorphTargets
            NUM_TARGETS_BUFFERS: NumberOfTargetsBuffers
        }

        ForcedRenderState {
            FaceCull Off
            DepthTest On
            DepthWrite On
            PolyOffset 5 3
            ColorWrite Off
        }

    }


    Technique PostShadow {
        VertexShader GLSL330 GLSL310 GLSL300 GLSL150 GLSL100:   Common/MatDefs/Shadow/PostShadow.vert
        FragmentShader GLSL330 GLSL310 GLSL300 GLSL150 GLSL100: Common/MatDefs/Shadow/PostShadowPBR.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        Defines {
            TEMPORAL_GPU_INSTANCES : TemporalGpuInstances
            TEMPORAL_VELOCITY : TemporalVelocity
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            HARDWARE_SHADOWS : HardwareShadows
            FILTER_MODE : FilterMode
            PCFEDGE : PCFEdge
            DISCARD_ALPHA : AlphaDiscardThreshold
            SHADOWMAP_SIZE : ShadowMapSize
            FADE : FadeInfo
            PSSM : Splits
            POINTLIGHT : LightViewProjectionMatrix5
            NUM_BONES : NumberOfBones
            INSTANCING : UseInstancing
            BACKFACE_SHADOWS: BackfaceShadows
            NUM_MORPH_TARGETS: NumberOfMorphTargets
            NUM_TARGETS_BUFFERS: NumberOfTargetsBuffers
        }

        ForcedRenderState {
            Blend Modulate
            DepthWrite Off
            PolyOffset -0.1 0
        }
    }

    Technique PreNormalPass {

        VertexShader GLSL330 GLSL300 GLSL150 GLSL100 :   Common/MatDefs/SSAO/normal.vert
        FragmentShader GLSL330 GLSL300 GLSL150 GLSL100 : Common/MatDefs/SSAO/normal.frag

        WorldParameters {
            WorldViewProjectionMatrix
            WorldViewMatrix
            NormalMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        Defines {
            TEMPORAL_GPU_INSTANCES : TemporalGpuInstances
            TEMPORAL_VELOCITY : TemporalVelocity
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            BASECOLORMAP_ALPHA : BaseColorMap
            NUM_BONES : NumberOfBones
            INSTANCING : UseInstancing
            NUM_MORPH_TARGETS: NumberOfMorphTargets
            NUM_TARGETS_BUFFERS: NumberOfTargetsBuffers
        }

    }

    Technique Glow {

        VertexShader GLSL330 GLSL300 GLSL150 GLSL100:   Common/MatDefs/Misc/Unshaded.vert
        FragmentShader GLSL330 GLSL300 GLSL150 GLSL100: Common/MatDefs/Light/PBRGlow.frag

        WorldParameters {
            WorldViewProjectionMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        Defines {
            TEMPORAL_GPU_INSTANCES : TemporalGpuInstances
            TEMPORAL_VELOCITY : TemporalVelocity
            HAS_EMISSIVEMAP : EmissiveMap
            HAS_EMISSIVECOLOR : Emissive
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            NEED_TEXCOORD1
            NUM_BONES : NumberOfBones
            INSTANCING : UseInstancing
            NUM_MORPH_TARGETS: NumberOfMorphTargets
            NUM_TARGETS_BUFFERS: NumberOfTargetsBuffers
        }
    }


    Technique SurfaceCapture {
        LightModel DeferredSurface

        VertexShader GLSL330:   Common/MatDefs/Light/PBRLighting.vert
        FragmentShader GLSL330: Common/MatDefs/Light/PBRLighting.frag

        WorldParameters {
            WorldViewProjectionMatrix
            CameraPosition
            WorldMatrix
            WorldNormalMatrix
            ViewProjectionMatrix
            ViewMatrix
        }

        Defines {
            TEMPORAL_GPU_INSTANCES : TemporalGpuInstances
            TEMPORAL_VELOCITY : TemporalVelocity
            DEFERRED_GBUFFER
            DEFERRED_GI_PAYLOAD : DeferredGiPayload
            DEFERRED_GI_LIGHT : DeferredGiInLighting
            SURFACE_CAPTURE
            BOUND_DRAW_BUFFER: BoundDrawBuffer
            BASECOLORMAP : BaseColorMap
            NORMALMAP : NormalMap
            NORMALSCALE : NormalScale
            METALLICMAP : MetallicMap
            ROUGHNESSMAP : RoughnessMap
            EMISSIVEMAP : EmissiveMap
            EMISSIVE : Emissive
            SPECGLOSSPIPELINE : UseSpecGloss
            PARALLAXMAP : ParallaxMap
            NORMALMAP_PARALLAX : PackedNormalParallax
            STEEP_PARALLAX : SteepParallax
            LIGHTMAP : LightMap
            SEPARATE_TEXCOORD : SeparateTexCoord
            DISCARD_ALPHA : AlphaDiscardThreshold
            NUM_BONES : NumberOfBones
            INSTANCING : UseInstancing
            USE_PACKED_MR: MetallicRoughnessMap
            USE_PACKED_SG: SpecularGlossinessMap
            SPECULARMAP : SpecularMap
            SPECULAR_AA : UseSpecularAA
            SPECULAR_AA_SCREEN_SPACE_VARIANCE : SpecularAASigma
            SPECULAR_AA_THRESHOLD : SpecularAAKappa
            GLOSSINESSMAP : GlossinessMap
            NORMAL_TYPE: NormalType
            VERTEX_COLOR : UseVertexColor
            AO_MAP: LightMapAsAOMap
            AO_PACKED_IN_MR_MAP : AoPackedInMRMap
            AO_STRENGTH : AoStrength
            NUM_MORPH_TARGETS: NumberOfMorphTargets
            NUM_TARGETS_BUFFERS: NumberOfTargetsBuffers
            HORIZON_FADE: HorizonFade
            EXPOSUREMAP : SunLightExposureMap
            USE_VERTEX_COLORS_AS_SUN_INTENSITY : UseVertexColorsAsSunIntensity
            STATIC_SUN_INTENSITY : StaticSunIntensity
            BRIGHTEN_INDOOR_SHADOWS : BrightenIndoorShadows
            DEBUG_VALUES_MODE : DebugValuesMode
            USE_FOG : UseFog
            FOG_LINEAR : LinearFog
            FOG_EXP : ExpFog
            FOG_EXPSQ : ExpSqFog
            HSV_OFFSET : HSVOffset
        }
    }
}
