ShaderNodeDefinitions{
    ShaderNodeDefinition VertexDivideFloat {
        Type: Vertex
        Shader GLSL100: Common/MatDefs/ShaderNodes/Math/divideFloat.glsl
        Documentation{
            Divides two floats in the vertex stage.
            @input float a the numerator
            @input float b the denominator
            @output float result the quotient
        }
        Input {
            float a 0.0
            float b 1.0
        }
        Output {
            float result
        }
    }
}
