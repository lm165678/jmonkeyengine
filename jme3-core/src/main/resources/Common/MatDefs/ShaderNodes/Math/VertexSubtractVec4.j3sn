ShaderNodeDefinitions{
    ShaderNodeDefinition VertexSubtractVec4 {
        Type: Vertex
        Shader GLSL100: Common/MatDefs/ShaderNodes/Math/subtractVec4.glsl
        Documentation{
            Subtracts two vec4 values in the vertex stage.
            @input vec4 a the first vector
            @input vec4 b the second vector
            @output vec4 result the difference
        }
        Input {
            vec4 a vec4(0.0)
            vec4 b vec4(0.0)
        }
        Output {
            vec4 result
        }
    }
}
