ShaderNodeDefinitions{
    ShaderNodeDefinition NormalizeVec2 {
        Type: Fragment
        Shader GLSL100: Common/MatDefs/ShaderNodes/Math/normalizeVec2.glsl
        Documentation{
            Normalizes a vec2.
            @input vec2 value the input vector
            @output vec2 result the normalized vector
        }
        Input {
            vec2 value vec2(1.0, 0.0)
        }
        Output {
            vec2 result
        }
    }
}
