ShaderNodeDefinitions{
    ShaderNodeDefinition VertexSubtractFloat {
        Type: Vertex
        Shader GLSL100: Common/MatDefs/ShaderNodes/Math/subtractFloat.glsl
        Documentation{
            Subtracts two floats in the vertex stage.
            @input float a the first float
            @input float b the second float
            @output float result the difference
        }
        Input {
            float a 0.0
            float b 0.0
        }
        Output {
            float result
        }
    }
}
