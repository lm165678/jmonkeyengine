ShaderNodeDefinitions{
    ShaderNodeDefinition DotVec4 {
        Type: Fragment
        Shader GLSL100: Common/MatDefs/ShaderNodes/Math/dotVec4.glsl
        Documentation{
            Computes the dot product of two vec4 values.
            @input vec4 a the first vector
            @input vec4 b the second vector
            @output float result the dot product
        }
        Input {
            vec4 a vec4(0.0)
            vec4 b vec4(0.0)
        }
        Output {
            float result
        }
    }
}
