ShaderNodeDefinitions{
    ShaderNodeDefinition DotVec2 {
        Type: Fragment
        Shader GLSL100: Common/MatDefs/ShaderNodes/Math/dotVec2.glsl
        Documentation{
            Computes the dot product of two vec2 values.
            @input vec2 a the first vector
            @input vec2 b the second vector
            @output float result the dot product
        }
        Input {
            vec2 a vec2(0.0)
            vec2 b vec2(0.0)
        }
        Output {
            float result
        }
    }
}
