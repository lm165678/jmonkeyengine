ShaderNodeDefinitions{
    ShaderNodeDefinition PBRLighting {
        Type: Fragment
        Shader GLSL100: Common/MatDefs/ShaderNodes/PBRLighting/pbrLighting.frag
        Documentation{
            Metallic-roughness PBR direct lighting for a MultiPass forward technique. Ambient is diffuse only; IBL, shadows and deferred output are not included.
            @input vec4 baseColor the base material color
            @input float metallic the metalness factor
            @input float roughness the surface roughness
            @input float ao the ambient occlusion factor
            @input vec3 worldPosition the world-space position
            @input vec3 worldNormal the world-space normal
            @input vec3 viewDir the direction toward the camera
            @input vec4 lightColor the current light color
            @input vec4 lightPosition the current world-space light position
            @input mat4 viewMatrixInverse the inverse camera view matrix
            @input vec4 lightDirection the current view-space spot direction
            @input vec4 ambientLightColor the scene ambient light
            @output vec4 outColor the lit fragment color
        }
        Input {
            vec4 baseColor vec4(1.0)
            float metallic 0.0
            float roughness 0.5
            float ao 1.0
            vec3 worldPosition
            vec3 worldNormal
            vec3 viewDir
            vec4 lightColor
            vec4 lightPosition
            mat4 viewMatrixInverse
            vec4 lightDirection
            vec4 ambientLightColor
        }
        Output {
            vec4 outColor
        }
    }
}
