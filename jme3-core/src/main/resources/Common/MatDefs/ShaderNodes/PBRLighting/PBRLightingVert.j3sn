ShaderNodeDefinitions{
    ShaderNodeDefinition PBRLightingVert {
        Type: Vertex
        Shader GLSL100: Common/MatDefs/ShaderNodes/PBRLighting/pbrLightingVert.vert
        Documentation{
            Computes world-space inputs for the PBRLighting fragment node.
            @input vec3 modelPosition the object-space position
            @input vec3 modelNormal the object-space normal
            @input mat4 worldViewProjectionMatrix the world-view-projection matrix
            @input mat4 worldMatrix the world matrix
            @input mat3 worldNormalMatrix the world-space normal matrix
            @input vec3 cameraPosition the world-space camera position
            @output vec4 projPosition the projected position
            @output vec3 worldPosition the world-space position
            @output vec3 worldNormal the world-space normal
            @output vec3 viewDir the direction toward the camera
        }
        Input {
            vec3 modelPosition
            vec3 modelNormal
            mat4 worldViewProjectionMatrix
            mat4 worldMatrix
            mat3 worldNormalMatrix
            vec3 cameraPosition
        }
        Output {
            vec4 projPosition
            vec3 worldPosition
            vec3 worldNormal
            vec3 viewDir
        }
    }
}
