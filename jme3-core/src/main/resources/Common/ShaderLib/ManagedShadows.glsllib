#ifndef JME_MANAGED_SHADOWS
#define JME_MANAGED_SHADOWS
uniform bool g_ManagedShadows;
#ifndef JME_SHADOW_RECEIVE
#define JME_SHADOW_RECEIVE
uniform bool g_ShadowReceive;
#endif
uniform sampler2D g_ShadowAtlas;
uniform sampler2D g_ShadowRecords;
uniform vec2 g_ShadowAtlasSize;
uniform float g_ShadowRecordCount;
uniform vec4 g_ShadowViewRow;

vec4 managedShadowRecord(float light, float texel) {
    return texture2D(g_ShadowRecords, vec2((texel + 0.5) / 36.0,
            (light + 0.5) / g_ShadowRecordCount));
}

#import "Common/ShaderLib/ShadowFilter.glsllib"

// Project the receiver tangent plane analytically. Screen derivatives inside
// per-light/cascade branches are undefined, especially in tiled deferred paths.
// This formulation also handles perspective spot/point maps (including clip.w).
vec2 managedShadowDepthGradient(mat4 matrix, vec4 clip, vec3 normal, vec4 rect) {
    if (dot(normal, normal) < 1e-12) {
        return vec2(0.0);
    }
    vec3 n = normalize(normal);
    vec3 axis = abs(n.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(0.0, 1.0, 0.0);
    vec3 tangent = cross(n, axis);
    vec4 a = matrix * vec4(tangent, 0.0);
    vec4 b = matrix * vec4(cross(n, tangent), 0.0);
    vec3 da = a.xyz * clip.w - clip.xyz * a.w;
    vec3 db = b.xyz * clip.w - clip.xyz * b.w;
    float determinant = da.x * db.y - da.y * db.x;
    float scale = length(da.xy) * length(db.xy);
    // Degenerate/grazing projections have no reliable inverse. Fall back to
    // ordinary biased PCF instead of producing unbounded corrections or NaNs.
    if (scale < 1e-12 || abs(determinant) < scale * 0.001) {
        return vec2(0.0);
    }
    vec2 gradient = vec2(db.y * da.z - da.y * db.z,
            da.x * db.z - db.x * da.z) / determinant / rect.zw;
    // Bound the normalized depth change to one percent per atlas texel.
    return clamp(gradient / g_ShadowAtlasSize, vec2(-0.01), vec2(0.01)) * g_ShadowAtlasSize;
}

// Visibility modulates one light's direct contribution, never a composed color.
float managedShadow(float light, vec3 worldPosition, vec3 normal, bool receive) {
    if (!g_ManagedShadows || !receive || light < 0.0) {
        return 1.0;
    }
    vec4 header = managedShadowRecord(light, 0.0);
    if (header.y < 0.5) {
        return 1.0;
    }
    float face = 0.0;
    if (header.x < 0.5) {
        float depth = dot(g_ShadowViewRow, vec4(worldPosition, 1.0));
        vec4 splits = managedShadowRecord(light, 2.0);
        if (depth >= splits.x) {
            face = 1.0;
        }
        if (header.y > 1.5 && depth >= splits.y) {
            face = 2.0;
        }
        if (header.y > 2.5 && depth >= splits.z) {
            face = 3.0;
        }
        if (face >= header.y || (header.y > 3.5 && depth >= splits.w)) {
            return 1.0;
        }
    } else if (header.x < 1.5) {
        vec3 delta = worldPosition - managedShadowRecord(light, 1.0).xyz;
        vec3 magnitude = abs(delta);
        if (magnitude.y >= max(magnitude.x, magnitude.z)) {
            face = delta.y < 0.0 ? 0.0 : 1.0;
        } else if (magnitude.z >= magnitude.x) {
            face = delta.z < 0.0 ? 2.0 : 3.0;
        } else {
            face = delta.x < 0.0 ? 4.0 : 5.0;
        }
    }
    float offset = 3.0 + face * 4.0;
    mat4 matrix = mat4(managedShadowRecord(light, offset), managedShadowRecord(light, offset + 1.0),
            managedShadowRecord(light, offset + 2.0), managedShadowRecord(light, offset + 3.0));
    vec4 clip = matrix * vec4(worldPosition + normal * header.z, 1.0);
    if (clip.w <= 0.0) {
        return 1.0;
    }
    vec3 coordinate = clip.xyz / clip.w * 0.5 + 0.5;
    if (any(lessThan(coordinate, vec3(0.0))) || any(greaterThan(coordinate, vec3(1.0)))) {
        return 1.0;
    }
    vec4 rect = managedShadowRecord(light, 27.0 + face);
    vec2 uv = rect.xy + coordinate.xy * rect.zw;
    vec4 filterSettings = managedShadowRecord(light, 33.0);
    float radius = filterSettings.x;
    vec2 gradient = vec2(0.0);
    if (radius >= 0.5) {
        gradient = managedShadowDepthGradient(matrix, clip, normal, rect);
    }
    float visibility = ShadowFilter_TentPlane(g_ShadowAtlas, uv, g_ShadowAtlasSize, rect,
            coordinate.z - header.w, radius, gradient);
    // Per-light artistic attenuation; never multiply the composed scene color.
    return mix(1.0, visibility, clamp(filterSettings.y, 0.0, 1.0));
}
#endif
