#ifndef JME_SHADOW_FILTER
#define JME_SHADOW_FILTER
// Common visibility filtering for managed atlases and legacy shadow processors.
// HARDWARE_SHADOWS selects comparison samplers in legacy programs. Otherwise
// raw depth textures must use nearest sampling. Never interpolate depth before
// comparing it. UVs/reference depth passed here are already divided by w.
#if defined(HARDWARE_SHADOWS) && (!defined(GL_ES) || __VERSION__ >= 300)
    #define JME_FILTER_SAMPLER sampler2DShadow
#else
    #define JME_FILTER_SAMPLER sampler2D
#endif

float ShadowFilter_Compare(JME_FILTER_SAMPLER tex, vec2 uv, float referenceDepth) {
#if defined(HARDWARE_SHADOWS) && (!defined(GL_ES) || __VERSION__ >= 300)
    #if __VERSION__ >= 130
        return texture(tex, vec3(uv, referenceDepth));
    #else
        return shadow2D(tex, vec3(uv, referenceDepth)).r;
    #endif
#else
    return step(referenceDepth, texture2D(tex, uv).r);
#endif
}

float ShadowFilter_Bilinear(JME_FILTER_SAMPLER tex, vec2 uv, vec2 mapSize,
        vec4 rect, float referenceDepth) {
#if defined(HARDWARE_SHADOWS) && (!defined(GL_ES) || __VERSION__ >= 300)
    // Legacy renderer configures linear comparison filtering for soft modes.
    return ShadowFilter_Compare(tex, clamp(uv, rect.xy + 0.5 / mapSize,
            rect.xy + rect.zw - 0.5 / mapSize), referenceDepth);
#else
    vec2 texel = 1.0 / mapSize;
    vec2 position = uv * mapSize - 0.5;
    vec2 fraction = fract(position);
    vec2 base = (floor(position) + 0.5) * texel;
    vec2 lo = rect.xy + texel * 0.5;
    vec2 hi = rect.xy + rect.zw - texel * 0.5;
    float a = ShadowFilter_Compare(tex, clamp(base, lo, hi), referenceDepth);
    float b = ShadowFilter_Compare(tex, clamp(base + vec2(texel.x, 0.0), lo, hi), referenceDepth);
    float c = ShadowFilter_Compare(tex, clamp(base + vec2(0.0, texel.y), lo, hi), referenceDepth);
    float d = ShadowFilter_Compare(tex, clamp(base + texel, lo, hi), referenceDepth);
    return mix(mix(a, b, fraction.x), mix(c, d, fraction.x), fraction.y);
#endif
}

// Box PCF retains legacy kernel size and PCFEdge spacing, but each tap now
// interpolates visibility continuously. Fixed loop bounds also handle spacing 0.
float ShadowFilter_Box(JME_FILTER_SAMPLER tex, vec2 uv, vec2 mapSize,
        vec4 rect, float referenceDepth, float kernel, float spacing) {
    float visibility = 0.0;
    for (int y = 0; y < 8; y++) {
        if (float(y) >= kernel) {
            continue;
        }
        for (int x = 0; x < 8; x++) {
            if (float(x) >= kernel) {
                continue;
            }
            vec2 offset = (vec2(float(x), float(y)) - (kernel - 1.0) * 0.5) * spacing / mapSize;
            visibility += ShadowFilter_Bilinear(tex, uv + offset, mapSize, rect, referenceDepth);
        }
    }
    return visibility / (kernel * kernel);
}

float ShadowFilter_Tent(JME_FILTER_SAMPLER tex, vec2 uv, vec2 mapSize,
        vec4 rect, float referenceDepth, float radius) {
    vec2 texel = 1.0 / mapSize;
    vec2 lo = rect.xy + texel * 0.5;
    vec2 hi = rect.xy + rect.zw - texel * 0.5;
    if (radius < 0.5) {
        return ShadowFilter_Compare(tex, clamp(uv, lo, hi), referenceDepth);
    }

    // Continuous separable tent PCF. Compare raw depth at texel centers FIRST,
    // then filter visibility; bilinear filtering depth before comparison is wrong.
    // Subtexel weights vary continuously as the receiver/camera moves, unlike
    // the old nearest-sampled box kernel. No temporal noise or history required.
    // Radius 1/2 uses at most 16/36 fetches. Clamp every tap to this atlas tile
    // so adjacent lights/cascades can never contaminate the filter footprint.
    vec2 position = uv * mapSize - 0.5;
    vec2 base = floor(position);
    vec2 fraction = fract(position);
    float support = radius + 1.0;
    float visibility = 0.0;
    float totalWeight = 0.0;
    for (int y = -2; y <= 3; y++) {
        float wy = max(0.0, support - abs(float(y) - fraction.y));
        if (wy <= 0.0) {
            continue;
        }
        for (int x = -2; x <= 3; x++) {
            float wx = max(0.0, support - abs(float(x) - fraction.x));
            float weight = wx * wy;
            if (weight <= 0.0) {
                continue;
            }
            vec2 sampleUv = clamp((base + vec2(float(x), float(y)) + 0.5) * texel, lo, hi);
            visibility += weight * ShadowFilter_Compare(tex, sampleUv, referenceDepth);
            totalWeight += weight;
        }
    }
    return visibility / max(totalWeight, 0.00001);
}
#endif
