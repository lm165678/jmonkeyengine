#import "Common/ShaderLib/GI/ProbeMath.glsllib"

// Set once per surface before evaluating environment and material response.
float giEnvironmentDiffuseWeight = 1.0;
// Normal variation per world unit. Set this before branching on coverage.
float giReceiverCurvature = 0.0;
float giSkyDiffuseWeight = 1.0;
// Geometric coverage of total-light volumes, regardless of SH direction.
float giTotalSkyCoverage = 0.0;
// The first angular moment of visibility describes direction, not radiance.
vec3 giSkyBentMoment = vec3(0.0);
vec3 giSkyDirection(vec3 normal) {
    float anisotropy = clamp(length(giSkyBentMoment), 0.0, 1.0);
    if (anisotropy < 0.0001) {
        return normal;
    }
    vec3 bent = normalize(giSkyBentMoment);
    // Approximate the bent normal using low-frequency visibility.
    // Keep the bent direction above the surface, including at open-sky receivers.
    float amount = anisotropy * (1.0 - giSkyDiffuseWeight)
            * max(dot(bent, normal), 0.0);
    return normalize(mix(normal, bent, amount));
}
#ifdef GI_PROBES
#ifdef STATIC_PROBE_LIGHTMAP
uniform sampler2D m_GiStaticLightmap;
uniform float m_GiLightmapAtlasInset;
varying vec2 probeLightmapUv;
#endif
uniform float m_GiEnvironmentMix;
uniform float m_GiFadeDistance;
uniform sampler2D m_GiIrradiance;
uniform sampler2D m_GiMoments;
uniform sampler2D m_GiSkyVisibility;
uniform vec3 m_GiOrigin;
uniform vec3 m_GiSpacing;
uniform vec3 m_GiCounts;
uniform vec4 m_GiAtlas;
uniform float m_GiBias;
uniform bool m_GiEnabled;
uniform bool m_GiBakeBounce;
uniform vec2 m_GiEncoding;
uniform sampler2D m_GiVolumeData;
uniform int m_GiVolumeCount;
uniform int m_GiVolumeDataHeight;
uniform vec4 m_GiTextureSize;

bool giUsesOctahedralIrradiance(vec4 atlasInfo) {
    return mod(floor(fract(atlasInfo.w) * 256.0 + 0.01), 2.0) > 0.5;
}

vec4 giReadCoefficient(float probe, float coefficient, vec4 atlasInfo, vec4 dimensions) {
    vec2 tile = vec2(mod(probe, atlasInfo.x), floor(probe / atlasInfo.x));
    if (giUsesOctahedralIrradiance(atlasInfo)) {
        tile.y *= 9.0;
    }
    vec2 pixel = vec2(tile.x * 9.0 + coefficient + 0.5, tile.y + atlasInfo.y + 0.5);
    return texture2D(m_GiIrradiance, pixel / dimensions.xy);
}

// Mirror taps across the octahedral edge. With nearest filtering,
// a lookup cannot pull samples from the next probe's tile.
vec2 giWrapMomentPixel(vec2 pixel, float size) {
    if (pixel.x < 0.0) {
        pixel.x = -pixel.x - 1.0;
        pixel.y = size - 1.0 - pixel.y;
    }
    if (pixel.x >= size) {
        pixel.x = 2.0 * size - 1.0 - pixel.x;
        pixel.y = size - 1.0 - pixel.y;
    }
    if (pixel.y < 0.0) {
        pixel.y = -pixel.y - 1.0;
        pixel.x = size - 1.0 - pixel.x;
    }
    if (pixel.y >= size) {
        pixel.y = 2.0 * size - 1.0 - pixel.y;
        pixel.x = size - 1.0 - pixel.x;
    }
    return pixel;
}

// Neighboring records are independent. Mirror the bilinear taps across the
// octahedral seam and leave the first atlas row for relocation metadata.
vec3 giReadOctahedralIrradiance(float probe, vec3 normal, vec4 atlasInfo, vec4 dimensions) {
    vec2 tile = vec2(mod(probe, atlasInfo.x), floor(probe / atlasInfo.x)) * 9.0;
    tile.y += atlasInfo.y + 1.0;
    vec2 p = (giOctEncode(normalize(normal)) * 0.5 + 0.5) * 8.0 - 0.5;
    vec2 base = floor(p);
    vec2 f = fract(p);
    vec3 ll = texture2D(m_GiIrradiance, (tile + giWrapMomentPixel(base, 8.0) + 0.5) / dimensions.xy).rgb;
    vec3 lr = texture2D(m_GiIrradiance, (tile + giWrapMomentPixel(base + vec2(1.0, 0.0), 8.0) + 0.5) / dimensions.xy).rgb;
    vec3 ul = texture2D(m_GiIrradiance, (tile + giWrapMomentPixel(base + vec2(0.0, 1.0), 8.0) + 0.5) / dimensions.xy).rgb;
    vec3 ur = texture2D(m_GiIrradiance, (tile + giWrapMomentPixel(base + 1.0, 8.0) + 0.5) / dimensions.xy).rgb;
    return mix(mix(ll, lr, f.x), mix(ul, ur, f.x), f.y);
}

vec2 giMomentTexel(float probe, vec2 pixel, vec4 atlasInfo, vec4 dimensions) {
    float size = floor(atlasInfo.w);
    pixel = giWrapMomentPixel(pixel, size);
    vec2 tile = vec2(mod(probe, atlasInfo.x), floor(probe / atlasInfo.x));
    vec4 stored = texture2D(m_GiMoments,
            (tile * size + pixel + vec2(0.0, atlasInfo.z) + 0.5) / dimensions.zw);
    float variance = stored.a > 0.5 ? stored.b * stored.b
            : max(0.0, stored.g - stored.r * stored.r);
    return vec2(stored.r, variance);
}

// Receiver-plane correction: a neighboring direction reaches the same plane
// at a different distance. Comparing every tap with the central ray distance
// creates a repeating self-occlusion pattern even on perfectly flat surfaces.
float giVisibilityTap(float probe, vec2 pixel, vec3 direction, vec3 normal,
        float distanceToProbe, vec4 atlasInfo, vec4 dimensions) {
    float size = floor(atlasInfo.w);
    vec3 tapDirection = giOctDecode((giWrapMomentPixel(pixel, size) + 0.5) * (2.0 / size) - 1.0);
    float denominator = dot(tapDirection, normal);
    float numerator = dot(direction, normal);
    float tapDistance = distanceToProbe;
    // Project onto the receiver plane even at grazing incidence. Clamping this
    // ratio produces periodic false occlusion along wall/floor contacts. A tap
    // across the plane horizon cannot represent this receiver; reject it rather
    // than comparing its unrelated depth against the central-ray distance.
    if (abs(denominator) <= 1.0e-6 || numerator * denominator <= 0.0) {
        return 0.0;
    }
    tapDistance *= numerator / denominator;
    vec2 moments = giMomentTexel(probe, pixel, atlasInfo, dimensions);
    // Tolerance for roundoff in this comparison.
    float tolerance = 1.0e-6 * max(abs(tapDistance), abs(moments.x));
    return giVisibilityFromVariance(moments, max(0.0, tapDistance - tolerance));
}

// Filter E[d] and E[d^2] in the central direction before evaluating the
// one-sided Chebyshev bound. Reconstruct each tap's second moment from the
// stable mean/variance pair to support both historical distance encodings.
float giSingleVisibility(float probe, vec3 direction, float distanceToProbe,
        vec4 atlasInfo, vec4 dimensions) {
    float size = floor(atlasInfo.w);
    vec2 p = (giOctEncode(direction) * 0.5 + 0.5) * size - 0.5;
    vec2 base = floor(p);
    vec2 f = fract(p);
    vec2 lower = giMomentTexel(probe, base, atlasInfo, dimensions);
    vec2 right = giMomentTexel(probe, base + vec2(1.0, 0.0), atlasInfo, dimensions);
    vec2 top = giMomentTexel(probe, base + vec2(0.0, 1.0), atlasInfo, dimensions);
    vec2 upper = giMomentTexel(probe, base + 1.0, atlasInfo, dimensions);
    // The variance of a mixture includes the variance of its component means.
    // Centering before the sum avoids subtracting two large second moments.
    float mean = mix(mix(lower.x, right.x, f.x), mix(top.x, upper.x, f.x), f.y);
    vec4 delta = vec4(lower.x, right.x, top.x, upper.x) - mean;
    vec4 variances = vec4(lower.y, right.y, top.y, upper.y) + delta * delta;
    float variance = mix(mix(variances.x, variances.y, f.x),
            mix(variances.z, variances.w, f.x), f.y);
    return giVisibilityFromVariance(vec2(mean, variance), distanceToProbe);
}
// Blending depth moments would let a blocked foreground tap borrow
// background depth and introduce variance at silhouettes.
// Test each distribution first, then blend the visibility
// probabilities as in percentage-closer filtering.
float giReadVisibility(float probe, vec3 direction, vec3 normal, float distanceToProbe,
        vec4 atlasInfo, vec4 dimensions) {
    vec2 p = (giOctEncode(direction) * 0.5 + 0.5) * floor(atlasInfo.w) - 0.5;
    vec2 a = fract(p);
    vec2 b = floor(p);
    // B-spline weights remain positive, so the filter cannot ring.
    // Four taps per axis overlap across octahedral texel boundaries.
    vec2 a2 = a * a;
    vec2 a3 = a2 * a;
    vec2 w0 = (1.0 - 3.0 * a + 3.0 * a2 - a3) / 6.0;
    vec2 w1 = (4.0 - 6.0 * a2 + 3.0 * a3) / 6.0;
    vec2 w2 = (1.0 + 3.0 * a + 3.0 * a2 - 3.0 * a3) / 6.0;
    vec2 w3 = a3 / 6.0;
    float result = 0.0;
    for (int y = 0; y < 4; y++) {
        float wy = y == 0 ? w0.y : (y == 1 ? w1.y : (y == 2 ? w2.y : w3.y));
        for (int x = 0; x < 4; x++) {
            float wx = x == 0 ? w0.x : (x == 1 ? w1.x : (x == 2 ? w2.x : w3.x));
            result += wx * wy * giVisibilityTap(probe, b + vec2(float(x), float(y)) - 1.0,
                    direction, normal, distanceToProbe, atlasInfo, dimensions);
        }
    }
    return result;
}
// Eight-probe path: evaluate four distributions separately, then filter their
// visibility. Merging depths first invents variance at silhouettes and exposes
// angular atlas facets. This still performs exactly four moment texture reads.
float giCompactVisibility(float probe, vec3 direction, vec3 normal, float distanceToProbe,
        vec4 atlasInfo, vec4 dimensions, float worldDistance) {
    float size = floor(atlasInfo.w);
    vec2 p = (giOctEncode(direction) * 0.5 + 0.5) * size - 0.5;
    vec2 a = fract(p);
    vec2 b = floor(p);
    float result = 0.0;
    float numerator = dot(direction, normal);
    for (int i = 0; i < 4; i++) {
        vec2 offset = vec2(mod(float(i), 2.0), floor(float(i) / 2.0));
        vec2 pixel = giWrapMomentPixel(b + offset, size);
        vec3 tapDirection = giOctDecode((pixel + 0.5) * (2.0 / size) - 1.0);
        float denominator = dot(tapDirection, normal);
        vec2 weights = mix(1.0 - a, a, offset);
        float weight = weights.x * weights.y;
        vec2 moments = giMomentTexel(probe, b + offset, atlasInfo, dimensions);
        // One-sided receiver-plane bias only removes self-occlusion. Never
        // extend the query along a near-horizon ray or discard its weight:
        // either would manufacture dark bands on curved/nearby receivers.
        float tapDistance = distanceToProbe;
        if (numerator * denominator > 0.0 && abs(denominator) > 1.0e-6) {
            float projected = min(tapDistance, distanceToProbe * numerator / denominator);
            // A tangent plane is reliable over a planar footprint, not over an
            // angular texel spanning a curved receiver. Geometry normals only;
            // normal-map detail must not change the visibility estimator.
            // Octahedral footprint estimate, not an exact angular bound. Fade the
            // heuristic over 1..10 milliradians; flat geometry keeps full correction.
            float footprintTurn = giReceiverCurvature * worldDistance / max(size, 1.0);
            bool curved = mod(floor(fract(atlasInfo.w) * 128.0 + 0.01), 2.0) > 0.5;
            float planarConfidence = curved ? 1.0 - smoothstep(0.001, 0.01, footprintTurn) : 1.0;
            tapDistance = mix(tapDistance, projected, planarConfidence);
        }
        // One binary16 relative step covers stored-depth rounding and the
        // plane projection. This is depth tolerance, not a variance floor;
        // a zero-depth blocker remains blocked for positive receiver depth.
        float tolerance = 0.0009765625 * max(tapDistance, abs(moments.x));
        result += weight * giVisibilityFromVariance(moments, max(0.0, tapDistance - tolerance));
    }
    return result;
}
// Separable C2 edge window. A nearest-face minimum creates derivative seams
// wherever two face distances exchange order (visible diagonal bands in GI).
// Multiplying smooth axis windows also handles corners without that ridge.
float giOverlapWindow(vec3 edge, vec3 width) {
    vec3 t = clamp(edge / max(width, vec3(1.0e-6)), vec3(0.0), vec3(1.0));
    vec3 w = t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
    return w.x * w.y * w.z;
}

// Quadratic B-spline support over three grid positions per axis. Its weight and
// first derivative reach zero before a probe leaves the stencil, so rejecting
// back-side/invalid probes cannot expose the old eight-corner cell switch.
float giSpatialKernel(float distance) {
    float r = abs(distance);
    if (r < 0.5) {
        return 0.75 - r * r;
    }
    float edge = max(0.0, 1.5 - r);
    return 0.5 * edge * edge;
}

// Returns incident irradiance in linear HDR units. No material response is
// assumed here. The world-space normal must be normalized by the caller.
vec3 giSampleVolume(vec3 worldPosition, vec3 normal, vec3 planeNormal, vec3 origin, vec3 spacing,
        vec3 counts, vec2 encoding, vec4 atlasInfo, vec4 dimensions, float fade, bool metadata, out vec3 skyResult, out vec3 bentResult) {
    skyResult = vec3(1.0, 0.0, 0.0);
    bentResult = vec3(0.0);
    vec3 coordinate = (worldPosition - origin) / spacing;
    if (any(lessThan(coordinate, vec3(0.0))) || any(greaterThan(coordinate, counts - 1.0))) {
        return vec3(0.0);
    }
    // Use the same biased position for cell selection and visibility. Otherwise
    // a receiver exactly on a grid plane can give all usable front-side probes
    // zero trilinear weight. Keep coverage based on the actual surface position.
    bool wide = mod(floor(fract(atlasInfo.w) * 64.0 + 0.01), 2.0) > 0.5;
    bool surfaceLayout = mod(floor(fract(atlasInfo.w) * 16.0 + 0.01), 2.0) > 0.5;
    vec3 biasNormal = wide || surfaceLayout ? normal : planeNormal;
    vec3 samplePosition = worldPosition + biasNormal * m_GiBias;
    vec3 sampleCoordinate = clamp((samplePosition - origin) / spacing, vec3(0.0), counts - 1.0);
    vec3 base = wide ? floor(sampleCoordinate + 0.5) : min(floor(sampleCoordinate), counts - 2.0);
    vec3 alpha = sampleCoordinate - base;

    vec3 sum = vec3(0.0);
    float total = 0.0;
    float skySum = 0.0;
    vec3 bentSum = vec3(0.0);
    float weightScale = 0.0;
    bool hasSupport = false;
    // Descriptor fractional bits: 1/2 separated sky, 1/8 stabilized mixing.
    bool separated = fract(atlasInfo.w) > 0.25;
    bool stabilized = mod(floor(fract(atlasInfo.w) * 8.0 + 0.01), 2.0) > 0.5;
    float nextProbe = -1.0;
    // Surface bins have eight entries at most. Compact support has unit radius
    // in bin coordinates, so exactly 27 bins contain every possible contributor.
    // Kernel reaches zero before a bin leaves the stencil: no nearest-K jumps.
    for (int corner = 0; corner < 216; corner++) {
        if (!surfaceLayout && corner >= (wide ? 27 : 8)) {
            break;
        }
        float neighbor = float(corner);
        vec3 offset = vec3(mod(neighbor, 3.0), mod(floor(neighbor / 3.0), 3.0),
                floor(neighbor / 9.0)) - 1.0;
        if (!wide) {
            offset = giNeighborOffset(corner);
        }
        vec3 cell = base + offset;
        if (!surfaceLayout && (any(lessThan(cell, vec3(0.0)))
                || any(greaterThanEqual(cell, counts)))) {
            continue;
        }
        float probe = giProbeIndex(cell, counts);
        if (surfaceLayout) {
            float bucket = floor(float(corner) / 8.0);
            vec3 binCell = floor(sampleCoordinate) + vec3(mod(bucket, 3.0),
                    mod(floor(bucket / 3.0), 3.0), floor(bucket / 9.0)) - 1.0;
            if (any(lessThan(binCell, vec3(0.0))) || any(greaterThanEqual(binCell, counts))) {
                continue;
            }
            if (mod(float(corner), 8.0) < 0.5) {
                nextProbe = giReadCoefficient(giProbeIndex(binCell, counts), 4.0, atlasInfo, dimensions).a;
            }
            if (nextProbe < 0.0) {
                continue;
            }
            probe = nextProbe;
            nextProbe = giReadCoefficient(probe, 5.0, atlasInfo, dimensions).a;
            cell = vec3(mod(probe, counts.x), mod(floor(probe / counts.x), counts.y),
                    floor(probe / (counts.x * counts.y)));
        }
        vec4 c0 = giReadCoefficient(probe, 0.0, atlasInfo, dimensions);
        if (metadata && c0.a < 0.5) {
            continue;
        }
        vec4 c1 = giReadCoefficient(probe, 1.0, atlasInfo, dimensions);
        vec4 c2 = giReadCoefficient(probe, 2.0, atlasInfo, dimensions);
        vec4 c3 = giReadCoefficient(probe, 3.0, atlasInfo, dimensions);
        vec3 relocation = metadata ? vec3(c1.a, c2.a, c3.a) * spacing : vec3(0.0);
        vec3 probePosition = origin + cell * spacing + relocation;
        float radialWeight = 1.0;
        if (surfaceLayout) {
            float radius = length((samplePosition - probePosition) / spacing);
            if (radius >= 1.0) {
                continue;
            }
            float falloff = 1.0 - radius;
            radialWeight = falloff * falloff * falloff * falloff * (1.0 + 4.0 * radius);
        }
        hasSupport = true;
        vec3 delta = samplePosition - probePosition;
        float distanceToProbe = length(delta);
        vec3 direction = distanceToProbe > 1.0e-6 ? delta / distanceToProbe : normal;
        vec3 gridDelta = sampleCoordinate - cell;
        float spatialWeight = giSpatialKernel(gridDelta.x) * giSpatialKernel(gridDelta.y)
                * giSpatialKernel(gridDelta.z);
        if (!wide) {
            vec3 trilinear = max(vec3(0.001), mix(1.0 - alpha, alpha, offset));
            spatialWeight = trilinear.x * trilinear.y * trilinear.z;
        }
        float weight = surfaceLayout ? 1.0 : spatialWeight;
        // Reject probes behind the receiver tangent plane. Wrapped weights let
        // bright probes on the opposite face leak around depth-map silhouettes.
        // Use signed plane distance, not a normalized direction cosine: the
        // latter creates projection-centered hotspots near relocated probes.
        // A 20%-of-cell transition remains constant along a flat receiver and
        // approaches zero smoothly without admitting any back-side probes.
        // Evaluate from the unbiased surface; visibility still uses the bias.
        vec3 toProbe = probePosition - worldPosition;
        float frontDistance = dot(toProbe, normal);
        float hemisphereWidth = 0.2 * min(spacing.x, min(spacing.y, spacing.z));
        float normalWeight = smoothstep(0.0, hemisphereWidth, frontDistance);
        // Eight-corner support needs wrapped normals: hard half-space exclusion
        // can remove all useful corners. Wide/surface modes retain the strict gate.
        if (!wide && !surfaceLayout) {
            float wrap = (dot(normalize(toProbe + vec3(1.0e-20)), normal) + 1.0) * 0.5;
            normalWeight = (wrap * wrap + 0.2) * smoothstep(-hemisphereWidth, hemisphereWidth, frontDistance);
        }
        if (weight <= 0.0 || normalWeight <= 0.0) {
            continue;
        }
        float visibility;
        if (mod(floor(fract(atlasInfo.w) * 512.0 + 0.01), 2.0) > 0.5) {
            visibility = giSingleVisibility(probe, direction, distanceToProbe / encoding.x, atlasInfo, dimensions);
        } else if (!wide && !surfaceLayout) {
            visibility = giCompactVisibility(probe, direction, planeNormal,
                    distanceToProbe / encoding.x, atlasInfo, dimensions, distanceToProbe);
        } else {
            visibility = giReadVisibility(probe, direction, normal, distanceToProbe / encoding.x, atlasInfo, dimensions);
        }
        // Suppress low-confidence visibility to reduce thin-wall bleeding.
        float visibilityWeight = visibility * visibility * visibility;
        if (stabilized) {
            // Valid probes retain a small fallback contribution. This is an
            // explicit quality/leakage tradeoff, not a new visibility estimate.
            if (!wide && !surfaceLayout) {
                // Confidence must vary continuously with visibility. Cubing it
                // and crushing small weights again sharpens a smooth distance
                // distribution into almost binary bright/dark probe selection.
                // Keep the existing stabilized fallback, with a linear ramp.
                weight *= normalWeight * mix(0.05, 1.0, visibility);
            } else {
                float confidence = normalWeight * max(0.05, visibilityWeight);
                float lowWeight = min(1.0, confidence / 0.2);
                confidence *= lowWeight * lowWeight;
                weight *= confidence;
            }
        } else {
            weight *= normalWeight * visibilityWeight;
        }
        weight *= radialWeight;
        // Normalize by the largest positive weight while accumulating. An
        // absolute epsilon on the sum creates black bands as visibility changes,
        // although the normalized irradiance is invariant to this common scale.
        // Strict mode excludes exact zero weights; stabilized mode applies the
        // explicit fallback above. Invalid probes were excluded before either path.
        if (weight <= 0.0) {
            continue;
        }
        if (weight > weightScale) {
            float rescale = weightScale / weight;
            sum *= rescale;
            total *= rescale;
            skySum *= rescale;
            bentSum *= rescale;
            weightScale = weight;
        }
        weight /= weightScale;
        bool octahedral = giUsesOctahedralIrradiance(atlasInfo);
        vec3 irradiance = (octahedral ? giReadOctahedralIrradiance(probe, normal, atlasInfo, dimensions)
                : giEvaluateDiffuseSh9(c0.rgb, c1.rgb, c2.rgb, c3.rgb,
                giReadCoefficient(probe, 4.0, atlasInfo, dimensions).rgb,
                giReadCoefficient(probe, 5.0, atlasInfo, dimensions).rgb,
                giReadCoefficient(probe, 6.0, atlasInfo, dimensions).rgb,
                giReadCoefficient(probe, 7.0, atlasInfo, dimensions).rgb,
                giReadCoefficient(probe, 8.0, atlasInfo, dimensions).rgb, normal, m_GiBakeBounce ? 1.0 : 0.5)) * encoding.y;
        if (separated) {
            vec3 skyCoefficients[9];
            vec2 tile = vec2(mod(probe, atlasInfo.x), floor(probe / atlasInfo.x));
            if (octahedral) {
                tile.y *= 9.0;
            }
            for (int c = 0; c < 9; c++) {
                vec2 pixel = vec2(tile.x * 9.0 + float(c) + 0.5, tile.y + atlasInfo.y + 0.5);
                skyCoefficients[c] = texture2D(m_GiSkyVisibility, pixel / dimensions.xy).rgb;
            }
            float visibility = giEvaluateSh9(skyCoefficients[0], skyCoefficients[1],
                    skyCoefficients[2], skyCoefficients[3], skyCoefficients[4],
                    skyCoefficients[5], skyCoefficients[6], skyCoefficients[7], skyCoefficients[8], normal).r;
            skySum += clamp(visibility / 3.14159265359, 0.0, 1.0) * weight;
            // Undo l=1 versus l=0 cosine convolution and SH normalization.
            // sqrt(3)/2 * (c11,c1-1,c10)/c00 = integral(V*w)/integral(V).
            vec3 moment = 0.86602540378 * vec3(skyCoefficients[3].r,
                    skyCoefficients[1].r, skyCoefficients[2].r)
                    / max(skyCoefficients[0].r, 0.000001);
            moment /= max(1.0, length(moment));
            bentSum += moment * weight;
        }
        // Interpolate nonnegative irradiance in square-root space to reduce
        // bright-probe dominance, then return to linear HDR before material BRDF.
        sum += (stabilized ? sqrt(max(irradiance, vec3(0.0))) : irradiance) * weight;
        total += weight;
    }
    // Missing/invalid support falls back to other volumes or the sky. Total-light
    // coverage must not disappear merely because directional weights reach zero.
    if (total <= 0.0 && (separated || !hasSupport)) {
        return vec3(0.0);
    }
    vec3 edge = min(coordinate * spacing, (counts - 1.0 - coordinate) * spacing);
    float blend = fade > 0.0 ? giOverlapWindow(edge, vec3(fade)) : 1.0;
    skyResult = vec3(separated && total > 0.0 ? skySum / total : 0.0, blend, separated ? 0.0 : 1.0);
    bentResult = total > 0.0 ? bentSum / total : vec3(0.0);
    vec3 result = total > 0.0 ? sum / total : vec3(0.0);
    if (stabilized) {
        result *= result;
    }
    return result;
}

// Paged scene atlas: 128 descriptor rows (16 roots), then 32 index rows
// per root. Each index channel stores one-based brick slot, zero if absent.
vec4 giVolumeField(float row, float field) {
    float width = m_GiVolumeDataHeight > 0 ? 256.0 : 4.0;
    float height = float(m_GiVolumeDataHeight > 0 ? m_GiVolumeDataHeight : m_GiVolumeCount);
    return texture2D(m_GiVolumeData, vec2((field + 0.5) / width,
            (row + 0.5) / height));
}

float giBrickSlot(float root, vec3 coord, vec3 blocks) {
    float cell = coord.x + blocks.x * (coord.y + blocks.y * coord.z);
    float texel = floor(cell * 0.25);
    vec4 entry = giVolumeField(128.0 + root * 32.0 + floor(texel / 256.0), mod(texel, 256.0));
    float channel = mod(cell, 4.0);
    if (channel < 1.0) {
        return entry.x;
    }
    if (channel < 2.0) {
        return entry.y;
    }
    return channel < 3.0 ? entry.z : entry.w;
}

vec3 giSampleBrick(float root, vec3 worldPosition, vec3 normal, vec3 planeNormal,
        vec3 local, vec3 blocks, vec3 blockSize, out float blend, out vec3 skyResult, out vec3 bentResult) {
    blend = 0.0;
    skyResult = vec3(1.0, 0.0, 0.0);
    bentResult = vec3(0.0);
    vec3 coord = min(floor(local / blockSize), blocks - 1.0);
    float slot = giBrickSlot(root, coord, blocks) - 1.0;
    if (slot < 0.0) {
        return vec3(0.0);
    }
    vec3 cellSize = blockSize * 0.25;
    vec3 fromLow = local - coord * blockSize;
    vec3 fromHigh = blockSize - fromLow;
    blend = 1.0;
    // The halo gives both present bricks the same stencil at their boundary.
    // Fade only next to missing data, and keep the outer volume boundary lit.
    for (int axis = 0; axis < 3; axis++) {
        vec3 neighbor = coord;
        if (coord[axis] > 0.0 && fromLow[axis] < cellSize[axis]) {
            neighbor[axis] = coord[axis] - 1.0;
            if (giBrickSlot(root, neighbor, blocks) == 0.0) {
                blend = min(blend, smoothstep(0.0, cellSize[axis], fromLow[axis]));
            }
        }
        if (coord[axis] < blocks[axis] - 1.0 && fromHigh[axis] < cellSize[axis]) {
            neighbor[axis] = coord[axis] + 1.0;
            if (giBrickSlot(root, neighbor, blocks) == 0.0) {
                blend = min(blend, smoothstep(0.0, cellSize[axis], fromHigh[axis]));
            }
        }
    }
    if (blend <= 0.0) {
        return vec3(0.0);
    }
    vec4 origin = giVolumeField(slot, 0.0);
    vec4 spacing = giVolumeField(slot, 1.0);
    vec4 counts = giVolumeField(slot, 2.0);
    vec4 atlasInfo = giVolumeField(slot, 3.0);
    vec3 result = giSampleVolume(worldPosition, normal, planeNormal, origin.xyz, spacing.xyz, counts.xyz,
            vec2(spacing.w, counts.w), atlasInfo, m_GiTextureSize, 0.0, true, skyResult, bentResult);
    if (skyResult.y <= 0.0) {
        blend = 0.0;
    }
    return result;
}

struct GiRoot {
    float slot;
    vec4 origin;
    vec4 spacing;
    vec4 counts;
    vec3 size;
};

struct GiLighting {
    vec3 irradiance;
    vec3 sky;
    vec3 bent;
};

GiRoot giEmptyRoot() {
    return GiRoot(-1.0, vec4(0.0), vec4(0.0), vec4(0.0), vec3(0.0));
}

bool giRootBefore(GiRoot a, GiRoot b) {
    if (b.slot < 0.0) {
        return true;
    }
    float aSize = a.size.x * a.size.y * a.size.z;
    float bSize = b.size.x * b.size.y * b.size.z;
    if (aSize != bSize) {
        return aSize < bSize;
    }
    float aProbes = a.counts.x * a.counts.y * a.counts.z;
    float bProbes = b.counts.x * b.counts.y * b.counts.z;
    if (aProbes != bProbes) {
        return aProbes > bProbes;
    }
    // Equal-sized overlaps keep a spatially stable order when slots are reused.
    if (a.origin.x != b.origin.x) {
        return a.origin.x < b.origin.x;
    }
    if (a.origin.y != b.origin.y) {
        return a.origin.y < b.origin.y;
    }
    if (a.origin.z != b.origin.z) {
        return a.origin.z < b.origin.z;
    }
    return a.slot < b.slot;
}

// Find the first two covering roots using descriptor reads only. Further
// batches are needed only if one of the first candidates has no valid data.
void giFindRoots(vec3 worldPosition, GiRoot after, out GiRoot primary, out GiRoot backup) {
    primary = giEmptyRoot();
    backup = giEmptyRoot();
    for (int volume = 0; volume < 16; volume++) {
        if (volume >= m_GiVolumeCount) {
            break;
        }
        float slot = float(volume);
        vec4 counts = giVolumeField(slot, 2.0);
        if (any(lessThan(counts.xyz, vec3(2.0)))) {
            continue;
        }
        vec4 origin = giVolumeField(slot, 0.0);
        vec3 local = worldPosition - origin.xyz;
        if (any(lessThan(local, vec3(0.0)))) {
            continue;
        }
        vec4 spacing = giVolumeField(slot, 1.0);
        vec3 size = (counts.xyz - 1.0) * spacing.xyz;
        if (any(greaterThan(local, size))) {
            continue;
        }
        GiRoot root = GiRoot(slot, origin, spacing, counts, size);
        if (after.slot >= 0.0 && !giRootBefore(after, root)) {
            continue;
        }
        if (giRootBefore(root, primary)) {
            backup = primary;
            primary = root;
        } else if (giRootBefore(root, backup)) {
            backup = root;
        }
    }
}

GiLighting giEmptyLighting() {
    return GiLighting(vec3(0.0), vec3(1.0, 0.0, 0.0), vec3(0.0));
}

// Combine irradiance and sky data with the same coverage-aware interpolation.
GiLighting giMixLighting(GiLighting a, GiLighting b, float aCoverage, float bCoverage) {
    float coverage = aCoverage + bCoverage;
    if (coverage <= 0.0) {
        return giEmptyLighting();
    }
    float amount = bCoverage / coverage;
    vec3 sky = mix(a.sky, b.sky, amount);
    sky.y = coverage;
    return GiLighting(mix(a.irradiance, b.irradiance, amount), sky, mix(a.bent, b.bent, amount));
}

GiLighting giSampleRoot(GiRoot root, vec3 worldPosition, vec3 normal, vec3 planeNormal, out vec3 cellSize) {
    vec3 local = worldPosition - root.origin.xyz;
    float transition = 0.0;
    GiLighting fine = giEmptyLighting();
    cellSize = root.spacing.xyz;
    if (m_GiVolumeDataHeight > 0) {
        vec3 blocks = giVolumeField(root.slot, 4.0).xyz;
        if (blocks.x > 0.0) {
            vec3 blockSize = giVolumeField(root.slot, 5.0).xyz;
            cellSize = blockSize * 0.25;
            fine.irradiance = giSampleBrick(root.slot, worldPosition, normal, planeNormal,
                    local, blocks, blockSize, transition, fine.sky, fine.bent);
            if (root.origin.w > 0.0) {
                vec3 edge = min(local, root.size - local);
                fine.sky.y *= giOverlapWindow(edge, vec3(root.origin.w));
            }
        }
    }
    if (transition >= 1.0) {
        return fine;
    }
    vec4 atlasInfo = giVolumeField(root.slot, 3.0);
    GiLighting coarse;
    coarse.irradiance = giSampleVolume(worldPosition, normal, planeNormal, root.origin.xyz, root.spacing.xyz,
            root.counts.xyz, vec2(root.spacing.w, root.counts.w), atlasInfo,
            m_GiTextureSize, root.origin.w, true, coarse.sky, coarse.bent);
    if (transition <= 0.0) {
        return coarse;
    }
    return giMixLighting(coarse, fine, (1.0 - transition) * coarse.sky.y, transition * fine.sky.y);
}

float giRootInterior(GiRoot root, vec3 worldPosition, vec3 cellSize, GiRoot other) {
    vec3 local = worldPosition - root.origin.xyz;
    // Preserve an exclusive interior even for a two-probe grid. The fine
    // spacing keeps this transition stable when its bricks are evicted.
    vec3 width = root.origin.w > 0.0 ? vec3(root.origin.w) : min(cellSize, root.size * 0.25);
    vec3 low = local;
    vec3 high = root.size - local;
    if (other.slot >= 0.0) {
        // A shared face is not a hand-off between volumes. For example, two
        // room volumes can start on the same floor and still blend across X/Z.
        vec3 epsilon = min(root.size, other.size) * 1.0e-5;
        vec3 offset = root.origin.xyz - other.origin.xyz;
        low = mix(width, low, step(epsilon, abs(offset)));
        high = mix(width, high, step(epsilon, abs(offset + root.size - other.size)));
    }
    return giOverlapWindow(min(low, high), width);
}

GiLighting giSampleRoots(vec3 worldPosition, vec3 normal, vec3 planeNormal) {
    GiRoot after = giEmptyRoot();
    GiRoot chosen = giEmptyRoot();
    GiLighting primary = giEmptyLighting();
    vec3 primaryCell = vec3(0.0);
    for (int batch = 0; batch < 8; batch++) {
        GiRoot first;
        GiRoot second;
        giFindRoots(worldPosition, after, first, second);
        for (int index = 0; index < 2; index++) {
            GiRoot root = first;
            if (index == 1) {
                root = second;
            }
            if (root.slot < 0.0) {
                return primary;
            }
            float interior = 0.0;
            if (chosen.slot >= 0.0) {
                interior = giRootInterior(chosen, worldPosition, primaryCell, root);
                if (interior >= 1.0) {
                    return primary;
                }
            }
            vec3 cellSize;
            GiLighting sampled = giSampleRoot(root, worldPosition, normal, planeNormal, cellSize);
            if (sampled.sky.y <= 0.0) {
                continue;
            }
            if (chosen.slot >= 0.0) {
                // Both weights vanish at their own boundary, including where
                // two volumes cross without one fully enclosing the other.
                float backupInterior = giRootInterior(root, worldPosition, cellSize, chosen);
                float backupWeight = (1.0 - interior) * backupInterior;
                float total = interior + backupWeight;
                if (total > 0.0) {
                    float primaryWeight = interior / total;
                    float primaryCoverage = min(primaryWeight, primary.sky.y);
                    // A covering backup fills the primary's explicit fade.
                    // Limit compensation at the backup's boundary as well.
                    float backupCoverage = (backupWeight / total
                            + (primaryWeight - primaryCoverage) * backupInterior) * sampled.sky.y;
                    return giMixLighting(primary, sampled, primaryCoverage, backupCoverage);
                }
                return primary;
            }
            primary = sampled;
            chosen = root;
            primaryCell = cellSize;
            if (index == 0 && second.slot < 0.0) {
                return primary;
            }
            if (giRootInterior(root, worldPosition, cellSize, giEmptyRoot()) >= 1.0) {
                return primary;
            }
        }
        after = second;
    }
    return primary;
}

vec3 giReceiverPlane(vec3 worldPosition, vec3 normal) {
    // Derivatives must precede per-fragment volume coverage tests. Normal-map
    // detail must not perturb the receiver plane or its visibility bias.
    vec3 planeNormal = cross(dFdx(worldPosition), dFdy(worldPosition));
    float planeScale = max(abs(planeNormal.x), max(abs(planeNormal.y), abs(planeNormal.z)));
    planeNormal = planeScale > 0.0 ? normalize(planeNormal / planeScale) : normal;
    return planeNormal * (dot(planeNormal, normal) < 0.0 ? -1.0 : 1.0);
}

vec4 giSampleIndirectOnPlane(vec3 worldPosition, vec3 normal, vec3 planeNormal) {
    if (!m_GiEnabled) {
        return vec4(0.0);
    }
    GiLighting result;
    if (m_GiVolumeCount == 0) {
        vec4 atlasInfo = vec4(m_GiAtlas.x, 0.0, 0.0, m_GiAtlas.z);
        vec4 dimensions = vec4(m_GiAtlas.x * 9.0, m_GiAtlas.y, m_GiAtlas.xy * floor(m_GiAtlas.z));
        float fade = fract(m_GiAtlas.z) > 0.25 ? max(0.0, m_GiFadeDistance) : 0.0;
        result.irradiance = giSampleVolume(worldPosition, normal, planeNormal, m_GiOrigin, m_GiSpacing, m_GiCounts,
                m_GiEncoding, atlasInfo, dimensions, fade, m_GiAtlas.w > 0.5, result.sky, result.bent);
    } else {
        result = giSampleRoots(worldPosition, normal, planeNormal);
    }
    float coverage = result.sky.y;
    giTotalSkyCoverage = result.sky.z * coverage;
    giSkyBentMoment = result.bent * coverage;
    giSkyDiffuseWeight = mix(1.0, result.sky.x, coverage);
    return vec4(result.irradiance * coverage, coverage);
}
vec4 giSampleIndirect(vec3 worldPosition, vec3 normal) {
    if (!m_GiEnabled) {
        return vec4(0.0);
    }
    return giSampleIndirectOnPlane(worldPosition, normal, giReceiverPlane(worldPosition, normal));
}

float giCurvature(vec3 worldPosition, vec3 geometryNormal) {
    // Use interpolated mesh normals, never perturbed material normals. This is
    // a local curvature estimate, not a replacement for the actual triangle
    // plane used by depth projection. Hard/flat-shaded meshes cannot supply
    // smooth curvature information and retain the original plane behavior.
    vec3 dx = dFdx(worldPosition);
    vec3 dy = dFdy(worldPosition);
    vec3 nx = dFdx(geometryNormal);
    vec3 ny = dFdy(geometryNormal);
    return sqrt((dot(nx, nx) + dot(ny, ny))
            / max(dot(dx, dx) + dot(dy, dy), 1.0e-20));
}

vec3 giSampleIrradiance(vec3 worldPosition, vec3 normal, vec3 geometryNormal) {
    giReceiverCurvature = giCurvature(worldPosition, geometryNormal);
    vec3 plane = giReceiverPlane(worldPosition, normal);
    #ifdef STATIC_PROBE_LIGHTMAP
        vec4 cached = vec4(0.0);
        vec4 cachedSky = vec4(0.0);
        if (m_GiEnabled && !m_GiBakeBounce) {
            float inset = m_GiLightmapAtlasInset;
            vec2 lookup = probeLightmapUv;
            if (inset > 0.0) {
                lookup.y = clamp(lookup.y * 0.5, inset, 0.5 - inset);
            }
            cached = texture2D(m_GiStaticLightmap, lookup);
            if (cached.a > 0.0 && inset > 0.0) {
                cachedSky = texture2D(m_GiStaticLightmap, vec2(lookup.x, lookup.y + 0.5));
            }
            if (cached.a >= 1.0) {
                giSkyBentMoment = cachedSky.rgb;
                giSkyDiffuseWeight = cachedSky.a;
                giEnvironmentDiffuseWeight = clamp(m_GiEnvironmentMix, 0.0, 1.0);
                return cached.rgb;
            }
        }
    #endif
    vec4 sampleValue = giSampleIndirectOnPlane(worldPosition, normal, plane);
    giEnvironmentDiffuseWeight = 1.0 - sampleValue.a * (1.0 - clamp(m_GiEnvironmentMix, 0.0, 1.0));
    // Separated captures add direct sky to bounced radiance. Total captures
    // already contain sky: never inject it again into the next bounce.
    if (m_GiBakeBounce) {
        giEnvironmentDiffuseWeight = 1.0;
        giSkyDiffuseWeight = 1.0 - giTotalSkyCoverage;
        giSkyBentMoment = vec3(0.0);
    }
    #ifdef STATIC_PROBE_LIGHTMAP
        if (cached.a > 0.0) {
            // Projection jitter can move a bilinear tap across a coverage edge.
            // Apply stored premultiplied irradiance and use probes for the uncovered part.
            float remaining = 1.0 - cached.a;
            sampleValue.rgb = cached.rgb + sampleValue.rgb * remaining;
            giSkyBentMoment = cachedSky.rgb + giSkyBentMoment * remaining;
            giSkyDiffuseWeight = mix(giSkyDiffuseWeight, cachedSky.a, cached.a);
            giEnvironmentDiffuseWeight = mix(giEnvironmentDiffuseWeight,
                    clamp(m_GiEnvironmentMix, 0.0, 1.0), cached.a);
        }
    #endif
    return sampleValue.rgb;
}
// Compatibility for custom shaders without a separate geometry normal. Built-in
// normal-mapped materials use the three-argument entry above.
vec3 giSampleIrradiance(vec3 worldPosition, vec3 normal) {
    return giSampleIrradiance(worldPosition, normal, normal);
}
#endif
