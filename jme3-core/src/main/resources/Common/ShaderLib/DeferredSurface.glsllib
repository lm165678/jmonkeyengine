// Raw MRT write contract. Only record0.a is reserved for the model/receiver header.
// Model-specific channels must match that model's decoder in the lighting stage.
#ifdef DEFERRED_GBUFFER
uniform int m_DeferredShadingId;
#ifndef JME_SHADOW_RECEIVE
#define JME_SHADOW_RECEIVE
uniform bool g_ShadowReceive;
#endif
layout(location = 0) out vec4 outGBuffer0;
layout(location = 1) out vec4 outGBuffer1;
layout(location = 2) out vec4 outGBuffer2;
layout(location = 3) out vec4 outGBuffer3;
layout(location = 4) out vec4 outGBuffer4;
#ifdef DEFERRED_GI_PAYLOAD
layout(location = 6) out vec4 outDeferredGiReceiver;
vec4 deferredGiReceiver = vec4(0.0);
float deferredGiCurvature = 0.0;
#endif
#ifdef DEFERRED_GI_LIGHT
void setDeferredGiReceiver(vec3 position, vec3 normal, vec3 geometryNormal, vec3 response, bool sky) {
    // Alpha uses an exact 21-bit integer in the RGBA32F attachment. Keep the
    // original triangle-plane derivatives so depth edges do not change visibility.
    vec2 encoded = giOctEncode(giReceiverPlane(position, normal)) * 0.5 + 0.5;
    vec2 quantized = floor(clamp(encoded, 0.0, 1.0) * 1023.0 + 0.5);
    float packedNormal = 1.0 + quantized.x + 1024.0 * quantized.y;
    deferredGiReceiver = vec4(response, sky ? -packedNormal : packedNormal);
    deferredGiCurvature = min(giCurvature(position, geometryNormal), 65504.0);
}
#endif
vec4 deferredSurfaceColor;
#undef gl_FragColor
#define gl_FragColor deferredSurfaceColor

// Custom GBuffer techniques can choose their own attribute layout. Pass five raw
// records; the writer supplies the shared ID header and initializes every MRT.
void writeGBuffer(vec4 record0, vec4 record1, vec4 record2, vec4 record3, vec4 record4,
                  int shadingId) {
    // Shared header: integer model ID; fractional 0.25 opts out of receiving shadows.
    outGBuffer0 = vec4(record0.rgb, float(shadingId) + (g_ShadowReceive ? 0.0 : 0.25));
    outGBuffer1 = record1;
    outGBuffer2 = record2;
    outGBuffer3 = record3;
    outGBuffer4 = record4;
    #ifdef DEFERRED_GI_PAYLOAD
        outDeferredGiReceiver = deferredGiReceiver;
        // Built-in GI receiver writers reserve record2.a for plane curvature.
        outGBuffer2.a = deferredGiCurvature;
    #endif
}

// Compatibility packer for existing built-in surface shaders. These meanings are
// NOT a universal GBuffer layout. Read the model's decoder under ShaderLib/Deferred:
// Lighting: parameter=shininess, specular=color, reflection/flags=legacy reflection.
// PBR: parameter=roughness, specular=F0, reflection/flags=terrain modifiers.
// Unshaded: only record3 (final color/opacity) is needed by its decoder.
void writeDeferredSurface(vec3 diffuse, vec3 normal, float parameter, vec3 specular, vec3 indirect,
                          float alpha, vec3 reflection, float flags, int model) {
    writeGBuffer(vec4(diffuse, 0.0), vec4(normal, parameter), vec4(specular, 0.0),
                 vec4(indirect, alpha), vec4(reflection, flags), model);
}
#endif
