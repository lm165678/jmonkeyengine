#ifdef TEMPORAL_VELOCITY
varying vec4 temporalCurrent;
varying vec4 temporalPrevious;
uniform bool m_TemporalValid;
#ifdef TEMPORAL_GPU_INSTANCES
varying float temporalInstanceValid;
#endif
#ifdef DEFERRED_GBUFFER
layout(location = 5) out vec4 outTemporalVelocity;
#else
layout(location = 1) out vec4 outTemporalVelocity;
#endif
vec4 temporalMotion() {
    #ifdef TEMPORAL_GPU_INSTANCES
        if (temporalInstanceValid < .5) {
            return vec4(0.0);
        }
    #endif
    if (!m_TemporalValid || temporalPrevious.w <= 0.0 || temporalCurrent.w <= 0.0) {
        return vec4(0.0);
    }
    vec3 previous = temporalPrevious.xyz / temporalPrevious.w;
    vec2 current = temporalCurrent.xy / temporalCurrent.w;
    return vec4((current - previous.xy) * 0.5, previous.z * 0.5 + 0.5, 1.0);
}
#endif
