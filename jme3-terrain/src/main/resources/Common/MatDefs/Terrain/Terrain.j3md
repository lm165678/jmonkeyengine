MaterialDef Terrain {
    ShadingModelId 3


	MaterialParameters {
        Int DeferredShadingId

        // use tri-planar mapping
        Boolean useTriPlanarMapping

		Texture2D Alpha -LINEAR
		Texture2D Tex1
		Texture2D Tex2
		Texture2D Tex3
		Float Tex1Scale
		Float Tex2Scale
		Float Tex3Scale
	}

	Technique {
		VertexShader GLSL100:   Common/MatDefs/Terrain/Terrain.vert
		FragmentShader GLSL100: Common/MatDefs/Terrain/Terrain.frag
		
		WorldParameters {
			WorldViewProjectionMatrix
		}

        Defines {
            TRI_PLANAR_MAPPING : useTriPlanarMapping
        }
	}
	
    Technique {
    }

    Technique GBuffer {
		VertexShader GLSL330:   Common/MatDefs/Terrain/Terrain.vert
		FragmentShader GLSL330: Common/MatDefs/Terrain/Terrain.frag

		WorldParameters {
			WorldViewProjectionMatrix
		}

        Defines {
            DEFERRED_GBUFFER
            TRI_PLANAR_MAPPING : useTriPlanarMapping
        }
	}
}
